{
  "name": "dsh-direct-open",
  "version": "0.1.0",
  "type": "module",
  "description": "Open delivered files, changed-file rows, and file mentions directly in the system default application, with a custom right-click menu and a settings page.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "file-open",
    "context-menu"
  ],
  "license": "MIT",
  "author": "likaileave",
  "homepage": "https://github.com/likaileave/dsh-direct-open#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/likaileave/dsh-direct-open.git"
  },
  "bugs": {
    "url": "https://github.com/likaileave/dsh-direct-open/issues"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "直接打开 / Direct Open",
    "description": "左键用系统默认程序打开文件，右键提供打开、定位、在 DSH 中查看和复制路径。"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
